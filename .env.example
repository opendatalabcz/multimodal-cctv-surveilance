# Copy to .env and fill in real values. Do not commit .env.

AZURE_OPENAI_API_KEY=
# Base resource URL, with or without the trailing /openai/v1
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# Deployment name, sent as "model" in the request body
AZURE_OPENAI_MODEL=gpt-5.6-luna

# Optional. Where captured frames are stored.
# Defaults to the project root (the folder holding pyproject.toml).
# CCTV_DATA_DIR=/mnt/data/cctv

# Optional Langfuse Cloud tracing. Leave disabled unless you want traces exported.
# Create a project in the EU region (https://cloud.langfuse.com) and paste its keys.
# The free Hobby plan keeps about 30 days of history. Traces can include prompts,
# answers, and tool text. Frame bytes are uploaded only when capture is enabled,
# and uploaded frames are a second copy of public CCTV imagery.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_IMAGES=false
