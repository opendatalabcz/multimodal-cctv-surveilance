# Copy to .env and fill in real values. Do not commit .env.

AZURE_OPENAI_API_KEY=
# Base resource URL, with or without the trailing /openai/v1
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# Deployment name, sent as "model" in the request body
AZURE_OPENAI_MODEL=gpt-4.1

# Optional. Where captured frames and logs are stored.
# Defaults to the project root (the folder holding pyproject.toml).
# CCTV_DATA_DIR=/mnt/data/cctv
